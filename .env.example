# Postgres (та же база, что у проекта Listings; схема отдельная)
DB_HOST=postgres-ha.local.modsen.app
DB_PORT=5432
DB_NAME=lodb
DB_USER=lo_agent
DB_PASSWORD=
DB_SCHEMA=scrapper

# Chrome: ОБЯЗАТЕЛЬНО настоящий, ОБЯЗАТЕЛЬНО с окном (headless режется Cloudflare)
CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
CDP_PORT=9333
# показать окно Chrome при получении куки (по умолчанию оно за пределами экрана)
CHROME_VISIBLE=false

# Охват: A — премиум, B — верхний middle, C — остальное
BRAND_TIERS=A
KOLVO=4

# Вежливость к сайту
REQUEST_DELAY_MS=1800
REQUEST_JITTER_MS=900

# Режим loop
INCREMENTAL_INTERVAL_MS=1800000
FULL_INTERVAL_MS=86400000
INCREMENTAL_PAGES=3
DETAIL_BUDGET=300
DETAIL_BUDGET_INCREMENTAL=60

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# Уведомления о выгодных позициях
DEAL_ALERT_PCT=20            # порог: на сколько процентов ниже рынка
DEAL_MIN_TREAD_MM=5         # отбрасывать, если остаток ТОЧНО меньше; не указан — оставляем
DEAL_MAX_ALERTS=0            # потолок сообщений за прогон, 0 = без ограничения
DEAL_MIN_COMPARABLES=8       # минимум сопоставимых, иначе не шумим
NOTIFY_WINDOW_HOURS=24       # окно событий; сутки дают запас на простой задачи

# Продавцы, чьи объявления не собираем (через запятую). 336639 выставляет цены
# в десятки тысяч рублей за шину и портит медианы; его строки в БД — статус 'excluded'
EXCLUDED_SELLERS=336639

# Детекция приостановленных кабинетов: уход не считается продажей, если у продавца
# исчезло сразу много объявлений (кнопка «Приостановить рекламу» или неоплата)
SELLER_PAUSE_MIN_COUNT=5     # ушло разом столько и больше — это пакетное снятие
SELLER_PAUSE_MIN_SHARE=0.5   # доля — только для мелких продавцов, исчезнувших целиком
SELLER_PAUSE_SMALL_COUNT=3   # минимум объявлений для правила «исчез целиком»

# Защита от массового ложного ухода (замерено 21.08: 1 319 помеченных ушедшими,
# 1 282 вернулись назавтра — обход был неполным, а разделы завершились штатно)
COMPLETE_MIN_SHARE=0.9       # доля от «Найдено N» сайта, ниже которой раздел неполный
GONE_MAX_SHARE=0.15          # доля активных, выше которой пометка ушедших отменяется
